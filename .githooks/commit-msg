#!/bin/sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if command -v git-ar >/dev/null 2>&1; then
  exec git-ar validate-commit-file "$1"
fi

if command -v mise >/dev/null 2>&1; then
  exec mise run ar -- validate-commit-file "$1"
fi

echo "arttra: git-ar or mise is required to validate the commit message" >&2
exit 1
