# Generated by `git ar setup`. This file is machine-local and must not be committed.
# Package-manager guidance remains in `git ar guard`; only critical operations belong here.

prefix_rule(
    pattern = [["sudo", "doas"]],
    decision = "forbidden",
    justification = "AIによる権限昇格は禁止です。必要な場合は人間が内容を確認して実行してください。",
    match = ["sudo rm /tmp/example", "doas sh"],
    not_match = ["echo sudo"],
)

prefix_rule(
    pattern = [["rm", "/bin/rm", "/usr/bin/rm"], ["-rf", "-fr"], ["/", "~"]],
    decision = "forbidden",
    justification = "rootまたはhomeを再帰削除できません。削除対象を限定して人間が確認してください。",
    match = ["rm -rf /", "/bin/rm -fr ~"],
    not_match = ["rm -rf target"],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "未commit変更を失うため禁止です。差分を確認し、安全な復旧方法を選んでください。",
    match = ["git reset --hard", "git reset --hard HEAD~1"],
    not_match = ["git reset --soft HEAD~1"],
)

prefix_rule(
    pattern = ["git", "clean", ["-fd", "-df", "-fdx", "-xdf", "-dfx", "-fxd"]],
    decision = "forbidden",
    justification = "未追跡fileを復元不能に削除するため禁止です。先に`git clean -nd`で確認してください。",
    match = ["git clean -fd", "git clean -fdx"],
    not_match = ["git clean -nd", "git status"],
)

prefix_rule(
    pattern = ["git", "push", ["--force", "-f"]],
    decision = "forbidden",
    justification = "無条件force pushは禁止です。必要なら人間が`--force-with-lease`を検討してください。",
    match = ["git push --force origin main", "git push -f"],
    not_match = ["git push", "git push --force-with-lease"],
)

prefix_rule(
    pattern = ["gh", "repo", "delete"],
    decision = "forbidden",
    justification = "repository削除はAIから実行できません。GitHub管理者が対象を確認してください。",
    match = ["gh repo delete owner/repository --yes"],
    not_match = ["gh repo view owner/repository"],
)

prefix_rule(
    pattern = ["gh", "api", ["-X", "--method"], "DELETE"],
    decision = "forbidden",
    justification = "任意GitHub APIのDELETEは禁止です。専用commandまたは人間の確認を使用してください。",
    match = ["gh api -X DELETE repos/owner/repository", "gh api --method DELETE repos/owner/repository"],
    not_match = ["gh api repos/owner/repository"],
)

prefix_rule(
    pattern = [["terraform", "pulumi"], "destroy"],
    decision = "forbidden",
    justification = "infrastructure全体の破棄はAIから実行できません。計画をreviewして人間が実行してください。",
    match = ["terraform destroy", "pulumi destroy --yes"],
    not_match = ["terraform plan", "pulumi preview"],
)

prefix_rule(
    pattern = ["kubectl", "delete", "namespace"],
    decision = "forbidden",
    justification = "namespace削除は影響範囲が大きいためAIから実行できません。",
    match = ["kubectl delete namespace production"],
    not_match = ["kubectl get namespace"],
)

prefix_rule(
    pattern = ["gcloud", "projects", "delete"],
    decision = "forbidden",
    justification = "GCP project削除はAIから実行できません。管理者が対象projectを確認してください。",
    match = ["gcloud projects delete example-project"],
    not_match = ["gcloud projects describe example-project"],
)

prefix_rule(
    pattern = ["firebase", "projects:delete"],
    decision = "forbidden",
    justification = "Firebase project削除はAIから実行できません。管理者が対象projectを確認してください。",
    match = ["firebase projects:delete example-project"],
    not_match = ["firebase projects:list"],
)
