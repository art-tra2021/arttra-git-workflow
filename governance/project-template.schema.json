{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://art-tra2021.github.io/arttra-git-workflow/schema/project-template.json",
  "title": "ART-TRA GitHub Project template",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "template_id", "display_name", "source_of_truth", "default_mode", "views", "fields", "workflows", "auto_add", "copy_policy", "notes"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "template_id": {"type": "string", "const": "arttra-project-standard"},
    "display_name": {"type": "string", "minLength": 1},
    "source_of_truth": {"type": "string", "const": "github_projects_v2"},
    "default_mode": {"type": "string", "const": "shared-view"},
    "views": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "layout", "filter"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "layout": {"type": "string", "enum": ["table", "board", "roadmap"]},
          "filter": {"type": "string"}
        }
      },
      "uniqueItems": true
    },
    "fields": {"type": "object", "minProperties": 1},
    "workflows": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
    "auto_add": {"type": "boolean", "const": false},
    "copy_policy": {"type": "string", "const": "views-fields-workflows-draft-items"},
    "notes": {"type": "array", "items": {"type": "string"}, "minItems": 1}
  }
}
