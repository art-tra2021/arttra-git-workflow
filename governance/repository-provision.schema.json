{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://art-tra2021.github.io/arttra-git-workflow/schema/repository-provision.json",
  "title": "ART-TRA repository provision request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "organization", "name", "purpose", "profile", "visibility", "owner_team", "risk_level", "review_policy", "ci_profile", "project_mode", "slack_channel", "initial_teams", "data_sensitivity"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "organization": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"},
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"},
    "purpose": {"type": "string", "minLength": 10},
    "profile": {"type": "string", "enum": ["minimal", "python", "typescript", "business"]},
    "visibility": {"type": "string", "enum": ["private", "internal", "public"]},
    "owner_team": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "risk_level": {"type": "string", "enum": ["low", "standard", "high", "critical"]},
    "review_policy": {"type": "string", "enum": ["flexible", "standard", "strict"]},
    "ci_profile": {"type": "string", "enum": ["inherit", "python", "typescript", "rust", "mixed", "documents", "unmanaged"]},
    "project_mode": {"type": "string", "enum": ["shared-view", "isolated-template"], "default": "shared-view"},
    "slack_channel": {"type": "string", "pattern": "^(?:#[a-z0-9][a-z0-9-]*|未定)$"},
    "initial_teams": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}, "uniqueItems": true},
    "data_sensitivity": {"type": "string", "enum": ["none", "internal", "confidential", "restricted"]},
    "additional_requirements": {"type": "string"},
    "source_issue": {"type": "integer", "minimum": 1},
    "requested_by": {"type": "string", "pattern": "^@[A-Za-z0-9-]+$"}
  }
}
