SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_APP_TOKEN=xapp-replace-me
SLACK_SIGNING_SECRET=replace-me
AR_SLACK_TRANSPORT=socket
AR_GITHUB_REPO=rozwer/arttra-git-lab
AR_GITHUB_LOGIN=replace-me
AR_GITHUB_OWNERS=art-tra2021
