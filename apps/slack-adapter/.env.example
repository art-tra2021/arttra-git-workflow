AR_PUBLIC_BASE_URL=https://replace-me.example.com
AR_SLACK_APPROVER_IDS=U0123456789
AR_SLACK_SELF_APPROVER_IDS=U0123456789
AR_APPROVAL_TTL_MINUTES=1440
AR_SLACK_CANVAS_CHANNEL_ID=C0123456789
