SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_APP_TOKEN=xapp-replace-me
SLACK_SIGNING_SECRET=replace-me
AR_SLACK_TRANSPORT=socket
AR_GITHUB_REPO=art-tra2021/arttra-git-workflow
AR_GITHUB_LOGIN=replace-me
AR_GITHUB_OWNERS=art-tra2021
AR_GITHUB_PROJECT_OWNER=art-tra2021
AR_GITHUB_PROJECT_NUMBER=8
AR_GITHUB_BACKEND=cli
# CLI backendは共有端末向けではない。個人作業を参照できるSlack userを1人に固定する。
AR_SLACK_CLI_USER_ID=U0123456789
# Cloud Runではappへ変更し、次の3値をSecret Manager等から注入する。
GITHUB_APP_ID=replace-me
GITHUB_APP_INSTALLATION_ID=replace-me
GITHUB_APP_PRIVATE_KEY=replace-me
GITHUB_OAUTH_CLIENT_ID=replace-me
GITHUB_OAUTH_CLIENT_SECRET=replace-me
AR_OAUTH_STATE_SECRET=replace-with-at-least-32-random-characters
AR_PUBLIC_BASE_URL=https://replace-me.example.com
# 3値をすべて設定した場合だけGoogle Calendar連携を有効にする。
GOOGLE_OAUTH_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=replace-me
AR_GOOGLE_TOKEN_KEY=replace-with-at-least-32-random-characters
GITHUB_WEBHOOK_SECRET=replace-me
AR_JOB_SECRET=replace-with-at-least-32-random-characters
AR_JOB_QUEUE=local
AR_GCP_PROJECT_ID=replace-me
AR_CLOUD_TASKS_LOCATION=asia-northeast1
AR_CLOUD_TASKS_QUEUE=arttra-github-events
AR_CLOUD_TASKS_SERVICE_ACCOUNT=replace-me@replace-me.iam.gserviceaccount.com
AR_SLACK_TEAM_ID=T0123456789
AR_SLACK_CALENDAR_USER_ID=U0123456789
# urgent、blocked、CI失敗、conflict、日次digestの通知先。未設定時はList channelを使う。
AR_SLACK_WORK_CHANNEL_ID=C0123456789
AR_REVIEW_REMINDER_MINUTES=1440
# 担当済み・未完了の仕事を期限の何日前から通知するか（1〜30日）
AR_DEADLINE_REMINDER_DAYS=3
AR_SLACK_APPROVER_IDS=U0123456789
AR_SLACK_SELF_APPROVER_IDS=U0123456789
# 通知outboxの監査後replayを実行できるSlack user ID。未設定時はreplayを拒否する。
AR_NOTIFICATION_REPLAY_OPERATOR_IDS=U0123456789
# capability名から明示的なGitHub loginへgrantする。全adminへの暗黙grantは行わない。
AR_GITHUB_CAPABILITY_GRANTS_JSON={"suppress_self_merge_channel_broadcast":["example-user"]}
AR_APPROVAL_TTL_MINUTES=1440
AR_SLACK_PROJECT_LIST_CHANNEL_ID=C0123456789
AR_SLACK_SHARED_REPOSITORY=art-tra2021/arttra-git-workflow
# CLI同期時に、作成したListをタブへ追加する管理者のSlack user ID（任意）
AR_SLACK_PROJECT_LIST_MANAGER_ID=U0123456789
AR_STATE_BACKEND=local
# mise taskはapps/slack-adapterを作業directoryにするため、repository rootへ保存する。
AR_LOCAL_STATE_DIR=../../.state
AR_FIRESTORE_PREFIX=arttra
