{
  "name": "@art-tra/slack-adapter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run test",
    "canvas:sync": "node --env-file-if-exists=.env src/sync-canvas.ts",
    "lint": "biome check .",
    "start": "node --env-file-if-exists=.env src/start.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google-cloud/firestore": "7.11.6",
    "@slack/bolt": "5.0.0",
    "@slack/web-api": "8.0.0",
    "express": "5.1.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/bun": "1.3.14",
    "@types/express": "5.0.3",
    "@types/node": "26.1.2",
    "typescript": "7.0.2"
  }
}
